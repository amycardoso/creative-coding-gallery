---
import type { Sketch } from "../data/fetch-sketches";
import Media from "./Media.astro";

interface Props {
  sketch: Sketch;
}

const { sketch } = Astro.props;
const detailUrl = `${import.meta.env.BASE_URL}${sketch.slug}/`;
const context = sketch.seriesTitle
  ? `${sketch.seriesTitle} ${sketch.seriesIndex}/${sketch.seriesCount}`
  : sketch.dateLabel;
---

<a href={detailUrl} class="card-link" data-slug={sketch.slug}>
  <article class="card">
    <div class="card-media" style={`aspect-ratio:${sketch.width}/${sketch.height}`}>
      <Media media={sketch.thumb} alt={sketch.title} width={sketch.width} height={sketch.height} />
    </div>
    <div class="card-body">
      <h2 class="card-title">{sketch.title}</h2>
      <p class="card-meta"><span class="card-category">{sketch.category}</span> · {context}</p>
    </div>
  </article>
</a>
